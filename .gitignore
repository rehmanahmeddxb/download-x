# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Buildozer / python-for-android
.buildozer/
bin/
.ccache/
local.properties

# Runtime artefacts generated by the app at first run.
# database.db is created fresh on every machine/device -- never commit it
# (a stale copy with absolute paths from another machine breaks the app).
database.db
downloads/*
!downloads/.gitkeep
temp/*
!temp/.gitkeep
logs/*
!logs/.gitkeep
instance/*
!instance/.gitkeep
database.db-journal

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
